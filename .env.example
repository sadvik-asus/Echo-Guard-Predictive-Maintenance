# ==========================================
# EchoGuard Environment Configuration
# Copy this file to .env and modify as needed
# ==========================================

# Sensor Sampling Parameters
SAMPLE_RATE=20000
N_FFT=2048
HOP_LENGTH=512

# Model Image Specifications
IMG_HEIGHT=256
IMG_WIDTH=256

# Training Hyperparameters
BATCH_SIZE=32
EPOCHS=15
LEARNING_RATE=0.001
DROPOUT_RATE=0.5

# Optional Custom Directory Overrides
# ECHOGUARD_DATA_DIR=/path/to/custom/data
# ECHOGUARD_MODELS_DIR=/path/to/custom/models
